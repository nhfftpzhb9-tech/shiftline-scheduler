# Supabase project URL and publishable key (safe for browser use; RLS protects all data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Used by the local Playwright/manual setup docs only. Never expose a service role key.
